{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "MassTransit": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Messaging": {
    "Transport": "RabbitMq"
  },
  "ConnectionStrings": {
    "jobradar": "Host=localhost;Port=5432;Database=jobradar;Username=postgres;Password=postgres",
    "rabbitmq": "amqp://guest:guest@localhost:5672"
  },
  "Database": {
    "MigrateOnStartup": true
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  }
}
