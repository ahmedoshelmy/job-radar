{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MassTransit": "Warning"
    }
  },
  "Messaging": {
    "Transport": "RabbitMq"
  },
  "ConnectionStrings": {
    "rabbitmq": "amqp://guest:guest@localhost:5672"
  },
  "Feeds": {
    "Mode": "Fixtures",
    "FixturesPath": "../../tests/fixtures/feeds",
    "StatePath": "state/feeds.json",
    "TickSeconds": 30,
    "Sources": [
      { "Kind": "greenhouse", "Board": "nilewave", "Label": "Nilewave Labs", "IntervalHours": 24 },
      { "Kind": "lever", "Board": "cairo-robotics", "Label": "Cairo Robotics", "IntervalHours": 24 },
      { "Kind": "ashby", "Board": "deltasoft", "Label": "Deltasoft", "IntervalHours": 24 },
      { "Kind": "workable", "Board": "pyramid-data", "Label": "Pyramid Data", "IntervalHours": 24 },
      { "Kind": "remotive", "Board": "software-dev", "Label": "Remotive", "IntervalHours": 12 },
      { "Kind": "arbeitnow", "Label": "Arbeitnow", "IntervalHours": 24 }
    ]
  }
}
