# Copy to .env to override the compose defaults. Placeholders only; never commit a real .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=change-me
API_PORT=5090
WEB_PORT=8090
RABBITMQ_UI_PORT=15673
# Fixtures (offline demo, default) or Live (polls the public job APIs politely; see ADR 0003)
FEEDS_MODE=Fixtures
# Set to http://aspire-dashboard:18889 and run `docker compose --profile obs up` to see traces/metrics/logs
OTEL_EXPORTER_OTLP_ENDPOINT=
# Azure only: Messaging__Transport=AzureServiceBus and ConnectionStrings__servicebus=<namespace connection string>
# Optional "why this matches" from a free model. None (default) = off.
# OpenRouter: AI_PROVIDER=OpenRouter, AI_MODEL=<model id ending in :free>, AI_API_KEY=<your key>
# Ollama on the host: AI_PROVIDER=Ollama, AI_MODEL=llama3.2, AI_BASE_URL=http://host.docker.internal:11434/v1/
AI_PROVIDER=None
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
